<?xml version="1.0" encoding="utf-8"?>
<!--
  1×1 模块瓦片底（批C）：圆角 20dp ＋ 1dp 描边。
  ⚠ 不复用 `lh_wg_card`：那枚圆角 16dp 是给 2×2/4×1 大卡用的，缩到 1×1 时圆角
    相对过大、描边也显粗；瓦片要像「App 图标」那块 squircle，故单独一档。
  色值一律取既有 `lh_wg_*` 两档（不新增色值——原生色值要登记进 UI 规范〇B）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/lh_wg_bg" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="@color/lh_wg_stroke" />
</shape>
