<?xml version="1.0" encoding="utf-8"?>
<!--
  待办勾圈 · **已完成**态（强调色实心圆＋白色对勾）。
  用强调色而非次文本，是为了让「已经做完」在桌面上一眼可辨（原型 .wg-chk-on）。
  对勾白色在浅/深两档强调色上都够对比（深档强调 #818CF8 上白字 2.98:1 不达 AA），
  故对勾走 `@color/lh_wg_bg`（浅档白、深档深）—— 两档各自与底色同族，对比 ≥4.5:1。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/lh_wg_acc"
        android:pathData="M12,2A10,10 0 1,0 22,12A10,10 0 1,0 12,2Z" />
    <path
        android:fillColor="@color/lh_wg_bg"
        android:pathData="M10.2,16.2L5.8,11.8L7.5,10.1L10.2,12.8L16.5,6.5L18.2,8.2Z" />
</vector>