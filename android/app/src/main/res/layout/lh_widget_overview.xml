<?xml version="1.0" encoding="utf-8"?>
<!--
  2×2 今日概览小组件（F2-1）· 冻结档 §5.6：
  尺寸 2×2；内容四周安全区 ≥42px（这里用 12dp 内边距＋系统另裁 55px 圆角）；
  读数 24sp 粗 / 标签 12sp 常规；字号固定不随系统放大截断；禁滑动/输入/动画。
  读数由 TodayOverviewWidget 从 SharedPreferences 快照写入（C5·不直读 sqlite）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lh_wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lh_wg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/lh_wg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/lh_widget_overview_name"
        android:textColor="@color/lh_wg_sub"
        android:textSize="9sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lh_widget_label_todo"
                android:textColor="@color/lh_wg_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/lh_wg_todo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/lh_widget_no_data"
                android:textColor="@color/lh_wg_fg"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lh_widget_label_habit"
                android:textColor="@color/lh_wg_sub"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lh_wg_habit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/lh_widget_no_data"
                    android:textColor="@color/lh_wg_fg"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lh_wg_habit_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:textColor="@color/lh_wg_sub"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/lh_wg_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progressDrawable="@drawable/lh_wg_progress" />

    <TextView
        android:id="@+id/lh_wg_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/lh_wg_sub"
        android:textSize="10sp" />
</LinearLayout>
