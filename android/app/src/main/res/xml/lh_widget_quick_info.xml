<?xml version="1.0" encoding="utf-8"?>
<!--
  4×1 快捷记录（F2-2）小组件元数据 · 冻结档 §5.6。
  updatePeriodMillis=0：App 存活时按需刷新（§6.3 禁轮询/常驻定时器）。
  **不写 android:configure**（2026-10-15 产品令）：配置页会在「从系统添加小组件」时
  先弹一次，多一步打扰；而它管的开关（四枚总开关 + 隐藏金额）App 设置页里全都有。
  代价＝长按菜单不再有系统自动生成的「编辑」项（那是 configure 的副产物，二者绑死）。

  resizeMode（2026-10-15 产品令开启尺寸调节，源自 8147 装机反馈）：
    只开 **horizontal**、锁 vertical——4:1 是横向长条，纵向拉高会把左右分栏拉成怪形，
    纵向一动就废。横向拉宽则两半各自平分，右侧读数自动跟着走。
    minResizeWidth 与 min 同值＝下界不失真。
  预览图两个都给：previewLayout 走 Android 12+ 标准口径；previewImage 给 MIUI 这类
  只认图的桌面（实测 MIUI 完全忽略 previewLayout，没图就回落应用图标 ⇒ 四枚长得
  一模一样，用户分不清 · 2026-10-15 装机实锤）。图由 tools/gen_widget_previews.py
  按真实布局生成，浅/深两档（drawable-nodpi + drawable-night-nodpi · C6）。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/lh_widget_quick_desc"
    android:initialLayout="@layout/lh_widget_quick"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="250dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/lh_widget_quick_preview"
    android:previewLayout="@layout/lh_widget_quick"
    android:resizeMode="horizontal"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
