<?xml version="1.0" encoding="utf-8"?>
<!--
  2×2 记账概览（批3）小组件元数据 · 与另两枚 2×2 同尺寸口径（110dp / targetCell 2×2），
  三枚 2×2 在桌面上视觉等重（用户参照的成熟记账 App 也是统一 2×2）。
  **不写 android:configure**（2026-10-15 产品令）：配置页会在「从系统添加小组件」时
  先弹一次，多一步打扰；而它管的开关（四枚总开关 + 隐藏金额）App 设置页里全都有。
  代价＝长按菜单不再有系统自动生成的「编辑」项（那是 configure 的副产物，二者绑死）。
  resizeMode 开两向：窄化时先舍底部说明行（lh_widget_ledger.xml 的 lh_wg_hint）。
  updatePeriodMillis=0：App 存活时按需刷新（§6.3 禁轮询）。
  预览图两个都给：previewLayout 走 Android 12+ 标准口径；previewImage 给 MIUI 这类
  只认图的桌面（实测 MIUI 完全忽略 previewLayout，没图就回落应用图标 ⇒ 四枚长得
  一模一样，用户分不清 · 2026-10-15 装机实锤）。图由 tools/gen_widget_previews.py
  按真实布局生成，浅/深两档（drawable-nodpi + drawable-night-nodpi · C6）。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/lh_widget_ledger_desc"
    android:initialLayout="@layout/lh_widget_ledger"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:previewImage="@drawable/lh_widget_ledger_preview"
    android:previewLayout="@layout/lh_widget_ledger"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />