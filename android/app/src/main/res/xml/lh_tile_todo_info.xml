<?xml version="1.0" encoding="utf-8"?>
<!--
  1×1 模块瓦片 · 待办（批C-1 首枚）。

  **不写 android:configure**（规格 §4.1/§9）：MIUI 桌面实测不跑它，而本批瓦片
  无参数、无需配置——不写它才是对的。
  `updatePeriodMillis="0"`：瓦片**永不刷新**（零数据零功耗·规格 §2）。
  `resizeMode="none"`：1×1 是它的唯一形态，拉大只会得到一片空白。
  **只给 `previewImage` 不给 `previewLayout`**：`previewLayout` 渲染的是
  `lh_tile.xml` 原样——图标槽为空、只剩一个标签，在 Android 12+ 桌面上比
  应用图标还难看；而 MIUI 只认 `previewImage`（缺图就回落应用图标 ⇒ 17 枚
  长得一模一样，2026-10-15 装机实锤）。图由 `tools/gen_widget_previews.py`
  按本布局生成，浅/深两档（drawable-nodpi ＋ drawable-night-nodpi · C6）。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/lh_tile_todo_desc"
    android:initialLayout="@layout/lh_tile"
    android:minHeight="40dp"
    android:minWidth="40dp"
    android:previewImage="@drawable/lh_tile_todo_preview"
    android:resizeMode="none"
    android:targetCellHeight="1"
    android:targetCellWidth="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
