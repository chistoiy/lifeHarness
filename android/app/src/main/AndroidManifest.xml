<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 通知与定时提醒（M0末A）：Android 13+ 运行时申请；开机重传排程 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- 批B（工单 悬浮胶囊增强批-20261014 §7）：app 外系统悬浮窗。
         SYSTEM_ALERT_WINDOW＝「显示在其他应用上层」特殊访问，运行时经
         Settings.canDrawOverlays 探问、ACTION_MANAGE_OVERLAY_PERMISSION 引导；
         FOREGROUND_SERVICE_SPECIAL_USE＝API 34+ specialUse 型前台服务声明
         （非 Play 分发，subtype property 仅作文档）。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- V1.41 同步与备份：INTERNET 用于用户自行配置的 WebDAV/S3 同步与
         既有天气查询（open-meteo）/ISBN 书目查询（豆瓣）；除此之外 App
         零网络请求（离线优先 / 隐私红线·终审修复波 Minor-3 如实登记）。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="lifeharness"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="false">
        <!-- U2（UX 审计真机批 2026-10-05）返回通道判别记录，三轮实测都在这里：
             · 6071（不写该属性）＝一次返回退 app；6072/6073（写 true）＝同样退。
               targetSdk 35+ 缺省即启用预测返回，所以「不写」与「写 true」同形。
             · 6073 带插桩实测：壳层页（今天/宫格模块页）按返回后 **120ms 内焦点已离开**，
               应用内日志页 `U2BACK` 留痕 0 条 ⇒ HomeShell 的 PopScope 根本没被咨询，
               不是「来不及落盘」（同码在雷电 API28 走 legacy 按键通道，7/7 正常且留痕读到）。
             · 同机对照：push 路由（记账→统计报表）返回正常弹回 ⇒ Flutter 在「顶路由可弹」时
               确实注册并处理了回调；壳层是 `canPop:false`，预测返回通道下这个 back 不归它，
               平台按默认动作把应用挪后台。
             ⇒ 本轮试 **显式 false**（退回 legacy 按键通道），让壳层那套「今天」唯一根出口
               判定重新被咨询。判据＝tile_back_probe 七条翻绿＋今天页首次返回出提醒条＋
               `U2BACK` 留痕出现。若 false 仍退，则回到 Dart 侧改拦截位置（app 根层），
               不许把这条当已修。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- R3-1（真机轮3 P0）：关掉 embedding 的 deeplink 路由通路。默认为开：
                 冷启动把 VIEW intent 的 data（content://…）当初始路由塞给 go_router
                 （GoException 错误页），热启动同走 pushRouteInformation。本 App 没有
                 URL 深链需求，打开方式文件由 MainActivity lh/intents 入队、Dart 侧
                 takeOpenFile 消费，不依赖这条路由，整路掐掉。activity 级元数据，
                 FlutterActivity 只读 ActivityInfo.metaData，不放 application 级。 -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- V1.53.4⑥ 系统「打开方式」接收本地 EPUB：
                 VIEW+content（主流文件管理器/微信附件走 SAF content uri）、
                 VIEW+file pathPattern（个别旧文件管理器给 file://）、
                 SEND+EXTRA_STREAM（「发送→其他应用」兜底通道）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:mimeType="application/epub+zip"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\.epub"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/epub+zip"/>
            </intent-filter>
            <!-- V1.64 批1 N-3（工单 交棒话术-20261004 §2 · 拍板已过门）：
                 md/markdown/text 同三路（content VIEW / file pathPattern / SEND），
                 导入落笔记「系统打开」临时夹；txt 吃 text/plain 广谱入口。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:mimeType="text/markdown"/>
                <data android:scheme="content" android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\.md"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\.markdown"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/markdown"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- flutter_local_notifications：定时通知发送 + 开机重传（需 ScheduleNotificationReceiver 权限声明） -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <!-- 批B：app 外系统悬浮窗载体（前台 Service＋WindowManager 悬浮视图）。
             起服务只从 app 前台触发（Dart 侧 sync 口径·规避 Android 14+ 后台
             起 FGS 限制）；「■ 结束」经意图拉起 MainActivity 入队、Dart 侧
             takePillEvent 消费（与 lh/intents 同模式）。 -->
        <service
            android:name=".TimerPillService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's active reading/media timer visible as a system overlay while the app is in the background" />
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
